<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtLessonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/txtLessonDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>

    <!-- 13. PDF Status in Admin -->
    <TextView
        android:id="@+id/txtPdfStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📄 PDF: Not uploaded"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/txtLessonStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnEditLesson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"/>

        <Button
            android:id="@+id/btnPublishLesson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Publish"/>

        <Button
            android:id="@+id/btnDisableLesson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disable"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnWatchVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Watch Video"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnManageQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Quiz"
        android:layout_marginTop="8dp" />

</LinearLayout>
